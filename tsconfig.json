{
  "extends": "@vue/tsconfig/tsconfig.json",
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "rootDir": "./src",
    "moduleResolution": "nodenext",
    "importHelpers": true,
    "isolatedModules": true,
    "types": ["vite-plus/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["node_modules", "android", "Android", "dist"]
}
